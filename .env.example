# TradeLoop API (tradeloop-backend). Browser calls go to /api/v1 on this app and are proxied here.
TRADELOOP_API_URL=http://localhost:4000

# Organization code whose public pages (storefront, Return trips) this site shows.
NEXT_PUBLIC_OPS_ORG=LUCENA-FRESH

# Development only: list the seeded demo logins on the sign-in page (password = backend SEED_PASSWORD).
NEXT_PUBLIC_DEMO_LOGINS=true
NEXT_PUBLIC_DEMO_PASSWORD=DevPassword123!
